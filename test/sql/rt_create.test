# name: test/sql/rt_create.test
# description: test raster extension
# group: [sql]

require raster

query I
SELECT
    COUNT(id)
FROM
    RT_Create(
        '/vsimem/raster-sample.tiff', 'EPSG:25830', 499980.0, 4789760.0, 510220.0, 4800000.0, 2048, 2048, 1, 3 /*GDT_Int16*/, -9999.0,
        driver_name := 'Memory',
        blocksize_x := 128,
        blocksize_y := 128
    )
;
----
256

query I
SELECT
    COUNT(id)
FROM
    RT_Create(
        '/vsimem/raster-sample.tiff', 'EPSG:25830', 499980.0, 4789760.0, 510220.0, 4800000.0, 2048, 2048, 1, 3 /*GDT_Int16*/, -9999.0,
        driver_name := 'Gtiff',
        blocksize_x := 512,
        blocksize_y := 512
    )
;
----
16

query I
SELECT
    metadata
FROM
    RT_Create(
        '/vsimem/raster-sample.tiff', 'EPSG:25830', 499980.0, 4789760.0, 510220.0, 4800000.0, 2048, 2048, 1, 3 /*GDT_Int16*/, -9999.0,
        driver_name := 'Memory',
        blocksize_x := 128,
        blocksize_y := 128
    )
LIMIT 1
;
