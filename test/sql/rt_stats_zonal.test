# name: test/sql/rt_stats_zonal.test
# description: test raster extension
# group: [sql]

require raster

statement ok
INSTALL spatial;

statement ok
LOAD spatial;

query IIIIII
WITH __clip_layer AS (
    SELECT geom FROM ST_Read('./test/data/CATAST_Pol_Township-PNA.geojson')
),
__stats AS (
    SELECT
        RT_CubeStats(databand_1, 0, tile_x, tile_y, metadata, geom) AS stats
    FROM
        __clip_layer,
        RT_Read('./test/data/mosaic/SCL.tif-land.vrt', blocksize_x := 8192, blocksize_y := 8192)
    WHERE
        ST_Intersects(__clip_layer.geom, geometry)
)
SELECT
    stats.minimum,
    stats.maximum,
    stats.mean,
    stats.stddev,
    stats.valid_count,
    stats.nodata_count
FROM
    __stats
;
----
0.0	15.0	1.18536257062812	2.3879033627367794	63891	0
