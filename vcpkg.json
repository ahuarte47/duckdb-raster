{
    "dependencies": [
        "openssl",
        "zlib",
        "geos",
        "expat",
        "snappy",
        "lz4",
        {
            "name": "sqlite3",
            "default-features": false,
            "features": ["rtree"]
        },
        {
            "name": "proj",
            "version>=": "9.8.1",
            "default-features": false,
            "features": [
                "net"
            ]
        },
        {
            "name": "gdal",
            "version>=": "3.12.4",
            "default-features": false,
            "features": [
                "curl","geos","hdf5","jpeg","lzma","openjpeg","openssl","png","zstd"
            ]
        },
        {
            "name": "tiff",
            "default-features": false,
            "features": [
                "jpeg","lerc","libdeflate","lzma","webp","zip","zstd"
            ]
        }
    ],
    "vcpkg-configuration": {
        "overlay-ports": [
            "./extension-ci-tools/vcpkg_ports",
            "./vcpkg_ports"
        ],
        "overlay-triplets": [
            "./extension-ci-tools/toolchains"
        ]
    },
    "builtin-baseline": "cd61e1e26a038e82d6550a3ebbe0fbbfe7da78e3"
}
